# Copie este arquivo para .env e preencha com os valores reais.
# O .env nao deve ser copiado para outras maquinas nem versionado.

# --- Firebird (FATURA.GDB) ---
FB_HOST=192.168.0.6
FB_PORT=3050
FB_DATABASE=E:\SISTEMA\BASE_CHEQUE\BASE\FATURA.GDB
FB_USER=SYSDBA
FB_PASSWORD=coloque_a_senha_aqui
FB_CHARSET=ASCII
FB_POOL_SIZE=5

# --- SFTP Porto Seguro (Porto Assistencia) ---
SFTP_HOST=sftp.portoseguro.com.br
SFTP_FALLBACK_IP=131.161.97.122
SFTP_PORT=2022
SFTP_USER=coloque_o_usuario_aqui
SFTP_PASSWORD=coloque_a_senha_aqui
SFTP_DESTINO=/Porto/Remessa

# --- Tela web (branch web-render) ---
# Dois usuarios fixos separados por virgula; a senha fica aqui no teste local e,
# no Render, em Environment (WEB_SENHA). WEB_SENHA_2 (opcional) = senha propria do 2o usuario.
WEB_USUARIOS=alberto@grupofedcorp.com.br,beneficiosocial@grupofedcorp.com.br
WEB_SENHA=coloque_a_senha_aqui
# Chave que assina o cookie de sessao (qualquer texto longo; o Render gera sozinho)
WEB_SEGREDO_SESSAO=
